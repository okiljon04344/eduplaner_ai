# EduPlanner AI environment reference.
# Do not put real secrets in this file and do not commit your private .env.

# Firebase values are generated into lib/firebase_options.dart by:
# flutterfire configure
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_API_KEY=your_public_firebase_api_key
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Gemini API key can be entered inside the app Settings screen and stored with
# flutter_secure_storage under key: gemini_api_key.
# For local runs you can also pass it without hardcoding:
# flutter run --dart-define=GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
