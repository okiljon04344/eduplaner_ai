rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    /// Returns true when the request carries a valid Firebase Auth token.
    function isAuth() {
      return request.auth != null;
    }

    /// Returns true when the authenticated user owns the given uid.
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    /// Returns true when the authenticated user is a member of the given
    /// study group.  Uses a server-side get() so the check is authoritative
    /// even if the client caches a stale membership list.
    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/study_groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/study_groups/$(groupId)).data.memberIds;
    }

    /// Returns true when a string field is a string and does not exceed the
    /// given length. Prevents oversized payloads or non-string Lists/Maps
    /// from bypassing `.size()` checks.
    function withinLength(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    /// Returns true when an optional/nullable string field is absent, null,
    /// or a string of at most [maxLen] chars.
    function optStringWithin(data, key, maxLen) {
      return !(key in data) || data[key] == null
        || withinLength(data[key], maxLen);
    }

    /// 休講/変更 note: absent, null, or a string of at most 200 chars.
    function statusNoteOk(data) {
      return optStringWithin(data, 'statusNote', 200);
    }

    /// Class status must be absent, null, or one of the 3 allowed enum values.
    function classStatusOk(data) {
      return !('status' in data) || data.status == null
        || data.status in ['normal', 'cancelled', 'changed'];
    }

    // ── User profiles ──────────────────────────────────────────────────────
    // Each user may only read/write their own profile document.
    // Field-length and key-count caps prevent storage abuse.
    match /users/{userId} {
      allow read: if isAuth() && isOwner(userId);
      allow write: if isAuth() && isOwner(userId)
        && request.resource.data.keys().size() <= 20
        && optStringWithin(request.resource.data, 'name',  200)
        && optStringWithin(request.resource.data, 'email', 320)
        && optStringWithin(request.resource.data, 'school', 200)
        && optStringWithin(request.resource.data, 'faculty', 200)
        && optStringWithin(request.resource.data, 'department', 200)
        && optStringWithin(request.resource.data, 'course', 200)
        && optStringWithin(request.resource.data, 'fcmToken', 500);
    }

    // ── Study groups ───────────────────────────────────────────────────────
    match /study_groups/{groupId} {
      // Any authenticated member may read the group document.
      allow read: if isAuth() && request.auth.uid in resource.data.memberIds;

      // Creating: caller must set themselves as owner and sole initial member.
      // Group name capped at 100 chars; join code exactly 6 chars of A-Z / 2-9
      // (a superset of the client generator's alphabet, which skips I/O/0/1).
      allow create: if isAuth()
        && request.resource.data.keys().size() <= 10
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z2-9]{6}$')
        && optStringWithin(request.resource.data, 'name', 100);

      // Joining by code is server-side only (joinGroupByCode Cloud Function).
      // Client-side updates are limited to the caller leaving the group:
      //   • code and name are immutable from the client; ownerId is too,
      //     except that the owner leaving may hand ownership to a remaining member.
      //   • memberIds may only shrink by exactly the caller's uid.
      //   • Group cannot be left completely empty via this path (the last
      //     member deletes the group instead — see `allow delete`).
      //   • The 60-member cap is enforced in joinGroupByCode, the only path
      //     that grows a group; capping here would only block leaving.
      allow update: if isAuth()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.name == resource.data.name
        && (request.resource.data.ownerId == resource.data.ownerId
            || (resource.data.ownerId == request.auth.uid
                && request.resource.data.ownerId in request.resource.data.memberIds))
        && request.resource.data.code == resource.data.code
        && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        && request.resource.data.memberIds.size() > 0;

      // The owner may hard-delete the group; so may its sole remaining member
      // (a non-owner who is left alone could otherwise never leave).
      allow delete: if isAuth()
        && (resource.data.ownerId == request.auth.uid
            || resource.data.memberIds == [request.auth.uid]);
    }

    // ── Timetable entries ──────────────────────────────────────────────────
    match /timetables/{docId} {
      // A user may read their own entries; group members may read shared ones.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
      // On create: caller must be the document owner. If groupId is set the
      // caller must already be a group member — prevents planting entries into
      // groups they don't belong to. Subject capped to prevent oversized docs.
      allow create: if isAuth()
        && request.resource.data.keys().size() <= 15
        && request.resource.data.userId == request.auth.uid
        && classStatusOk(request.resource.data)
        && statusNoteOk(request.resource.data)
        && optStringWithin(request.resource.data, 'subject', 100)
        && optStringWithin(request.resource.data, 'teacher', 100)
        && optStringWithin(request.resource.data, 'room', 100)
        && (!('groupId' in request.resource.data)
            || request.resource.data.groupId == null
            || isGroupMember(request.resource.data.groupId));
      // Only the original creator may edit or delete their own class row.
      // Update must keep the same owner and, if groupId changes, the caller
      // must be a member of the *new* group — otherwise a user could plant
      // their row into any group's shared timetable, or reassign a row to
      // another user's uid, just by editing an entry they already own.
      // Second branch: any current member of the row's group may report or
      // clear a 休講/変更 status on it, touching nothing but the status fields.
      allow update: if isAuth()
        && request.resource.data.keys().size() <= 15
        && classStatusOk(request.resource.data)
        && statusNoteOk(request.resource.data) && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && optStringWithin(request.resource.data, 'subject', 100)
          && optStringWithin(request.resource.data, 'teacher', 100)
          && optStringWithin(request.resource.data, 'room', 100)
          && (!('groupId' in request.resource.data)
              || request.resource.data.groupId == null
              || request.resource.data.groupId == resource.data.groupId
              || isGroupMember(request.resource.data.groupId)))
        ||
        (resource.data.groupId != null
          && isGroupMember(resource.data.groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusNote', 'statusDate', 'statusReportedBy'])
          && (!('statusReportedBy' in request.resource.data)
              || request.resource.data.statusReportedBy == null
              || request.resource.data.statusReportedBy == request.auth.uid))
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Assignments ────────────────────────────────────────────────────────
    // Strictly personal: each assignment belongs to exactly one user.
    match /assignments/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      // Update must keep the same owner — otherwise a user could reassign
      // one of their own assignment docs onto another user's uid.
      allow update: if isAuth()
        && request.resource.data.keys().size() <= 18
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && optStringWithin(request.resource.data, 'subject', 100)
        && optStringWithin(request.resource.data, 'title',   500)
        && optStringWithin(request.resource.data, 'description', 4000)
        && optStringWithin(request.resource.data, 'aiAdvice', 2000)
        && (!('aiCompletionPercent' in request.resource.data)
            || request.resource.data.aiCompletionPercent == null
            || (request.resource.data.aiCompletionPercent is number
                && request.resource.data.aiCompletionPercent >= 0
                && request.resource.data.aiCompletionPercent <= 100))
        && (!('aiMissingParts' in request.resource.data)
            || request.resource.data.aiMissingParts == null
            || (request.resource.data.aiMissingParts is list
                && request.resource.data.aiMissingParts.size() <= 20));
      allow create: if isAuth()
        && request.resource.data.keys().size() <= 18
        && request.resource.data.userId == request.auth.uid
        && optStringWithin(request.resource.data, 'subject', 100)
        && optStringWithin(request.resource.data, 'title',   500)
        && optStringWithin(request.resource.data, 'description', 4000);
    }

    // ── AI chat messages ───────────────────────────────────────────────────
    // Messages live in a subcollection keyed by the owner's uid.
    // The parent ai_chats/{userId} document itself has no rule = implicit deny.
    match /ai_chats/{userId}/messages/{msgId} {
      allow read, delete: if isAuth() && isOwner(userId);
      allow create, update: if isAuth() && isOwner(userId)
        && request.resource.data.keys().size() <= 10
        && optStringWithin(request.resource.data, 'content', 8000);
    }

    // ── AI content reports (Play AI-generated content policy) ──────────────
    // Write-only from the client: a user may file a report as themselves;
    // nobody reads these from the app (reviewed in the console).
    match /ai_reports/{reportId} {
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'botId', 'refId', 'excerpt', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && withinLength(request.resource.data.excerpt, 1000)
        && optStringWithin(request.resource.data, 'kind', 30)
        && optStringWithin(request.resource.data, 'botId', 50)
        && optStringWithin(request.resource.data, 'refId', 100);
    }
  }
}
