{
  "name": "eduplanner-ai-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "node --test 'test/*.test.js'",
    "test:rules": "NODE_BIN=\"$(command -v node)\" && firebase emulators:exec --only firestore --project eduplannerai-97365 \"$NODE_BIN --test test/rules/firestore_rules.test.js\"",
    "sync-push-strings": "node scripts/sync_push_strings.mjs",
    "sync-shared": "node scripts/sync_shared.mjs",
    "ai:keys": "node scripts/ai_keys.mjs",
    "ai:smoke": "node scripts/compare_providers.mjs --smoke",
    "ai:compare": "node scripts/compare_providers.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@google-cloud/vision": "6.2.0",
    "@google/genai": "^1.31.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "6.5.438",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "eslint": "^9.39.1"
  }
}
